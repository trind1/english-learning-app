{
  "name": "english-learning-app",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "overrides": {
    "test-exclude": {
      "minimatch": "9.0.9"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check package.json tsconfig.base.json eslint.config.mjs apps packages",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test --workspace @english-learning/web",
    "test:api": "npm run test --workspace @english-learning/api",
    "coverage:web": "npm run coverage --workspace @english-learning/web",
    "coverage:api": "npm run coverage --workspace @english-learning/api"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "9.39.5",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "3.2.6"
  }
}
