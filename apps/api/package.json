{
  "name": "@english-learning/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import ../../scripts/tsx-windows-shim.mjs --import tsx src/server.ts",
    "start": "node --import ../../scripts/tsx-windows-shim.mjs --import tsx src/server.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@english-learning/contracts": "0.0.0",
    "@prisma/client": "6.12.0",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.2",
    "helmet": "8.1.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "prisma": "6.12.0",
    "supertest": "7.1.3",
    "tsx": "^4.23.12"
  }
}
