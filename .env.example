# Copy this file to .env and replace development placeholders locally.
# Never commit real secret values. VITE_ variables are visible in the browser.

DATABASE_URL="file:./dev.db"
API_PORT="3000"
WEB_ORIGIN="http://localhost:5173"
TEST_TOKEN_SECRET="replace-with-at-least-32-random-characters"
AI_ENABLED="false"
# Use AI_PROVIDER="local" for an explicitly labelled deterministic development preview.
# Use AI_PROVIDER="gemini" with the shared backend-only AI_API_KEY for Gemini.
AI_PROVIDER="local"
AI_API_KEY=""
AI_MODEL=""
AI_FALLBACK_MODEL=""
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
AI_TIMEOUT_MS="30000"
VITE_API_BASE_URL="http://localhost:3000/api/v1"

# AI_ENABLED="true"
# AI_PROVIDER="gemini"
# AI_API_KEY="replace-with-a-backend-only-gemini-key"
# AI_MODEL="gemini-3.6-flash"
# AI_FALLBACK_MODEL="gemini-3.5-flash-lite"
# AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
