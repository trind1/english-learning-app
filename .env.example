# Copy this file to .env and replace development placeholders locally.
# Never commit real secret values. VITE_ variables are visible in the browser.

DATABASE_URL="file:./dev.db"
API_PORT="3000"
WEB_ORIGIN="http://localhost:5173"
TEST_TOKEN_SECRET="replace-with-at-least-32-random-characters"
AI_ENABLED="false"
AI_PROVIDER=""
AI_API_KEY=""
AI_TIMEOUT_MS="10000"
VITE_API_BASE_URL="http://localhost:3000/api/v1"
